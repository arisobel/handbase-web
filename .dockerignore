# Context exclusions for the production image build.
#
# The deployment tarball (deploy/deploy.ps1) already prunes most of this, but
# .dockerignore is what protects a local `docker compose build`, where the
# context is the working tree — node_modules and .venv included.
.git
.github

# Secrets and local configuration never belong in an image layer.
.env
.env.*
deploy/.env
*.pem
*.key
*.token

# Dependency and build output; the image builds its own.
.venv
venv
node_modules
frontend/node_modules
frontend/dist
dist
__pycache__
*.pyc
*.tsbuildinfo

# Not read by the build or the runtime.
docs
backend/tests
pytest.ini
docker-compose.yml
docker-compose.test.yml
*.log
*.sqlite
*.sqlite3
*.db
