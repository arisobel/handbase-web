APP_NAME=HandBase Web
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start with APP_ENV=production and this left as-is.
APP_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://handbase:handbase@db:5432/handbase
DEFAULT_LOCALE=en
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
APP_BUILD_REVISION=local

# Authentication — all optional; see docs/04_technical/ENVIRONMENT_VARIABLES.md
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# AUTH_COOKIE_NAME=handbase_refresh
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
